# =============================================================================
# SokoLink - environment variables (TEMPLATE)
# =============================================================================
#
# WARNING: THIS FILE IS COMMITTED TO A PUBLIC REPO. NEVER PUT REAL VALUES HERE.
#
# Placeholders only. Real secrets go in `.env`, which is gitignored:
#
#     cp .env.example .env       # then edit .env, never this file
#
# In production these same keys are set in the Railway dashboard
# (Variables tab), not in any file.
#
# Values are validated by backend/app/config.py. A missing or malformed key
# fails at startup with a readable message naming the key - not later, deep
# inside a request.
#
# Keys are grouped by the milestone that introduces them, so you only fill in
# what the current stage actually uses. Later-milestone keys are optional and
# the app boots without them.
# =============================================================================


# -----------------------------------------------------------------------------
# P0 - Application
# -----------------------------------------------------------------------------
APP_ENV="dev"                              # dev | test | prod
APP_BASE_URL="http://localhost:8000"       # public base URL, no trailing slash

# Signs storefront link tokens and sessions. Generate a real one for anything
# that is not local development:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="dev-only-insecure-key-change-me"


# -----------------------------------------------------------------------------
# P0 - Database   [REQUIRED]
# -----------------------------------------------------------------------------
# Railway > your Postgres service > Variables > DATABASE_URL. Paste it whole -
# the app adds the psycopg driver itself, so no hand-editing is needed.
#
# SokoLink needs its OWN database. Sharing one across projects has already
# caused a near-miss here: an unrelated app's tables collided and a migration
# offered to reset the whole schema.
DATABASE_URL="postgresql://user:password@host:5432/railway"

# A SEPARATE database for the test suite.
#
# Tests create tables and write rows. Leaving this unset makes database-backed
# tests SKIP rather than run somewhere dangerous; setting it to the same value
# as DATABASE_URL is refused outright.
TEST_DATABASE_URL=""


# -----------------------------------------------------------------------------
# P1 - Ingestion (Apify)
# -----------------------------------------------------------------------------
# apify.com > Settings > Integrations > Personal API token.
# Roughly $0.30 per 1,000 posts. Results are cached and a seller is scraped at
# most once a day - never per request, or the unit economics break as sellers
# are added.
APIFY_TOKEN=""

# The ACTOR to run - an actor name, NOT a token. The token above authenticates;
# this says which scraper to run.
APIFY_TIKTOK_ACTOR_ID="clockworks~tiktok-scraper"


# -----------------------------------------------------------------------------
# P1 - AI (Gemini)
# -----------------------------------------------------------------------------
# aistudio.google.com > Get API key.
# Reads a product and price from the cover image, and - when the price is not
# printed - watches and listens to the clip for a price spoken in Sheng.
# Keep billing enabled: the free tier caps at 20 requests/day.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"


# -----------------------------------------------------------------------------
# P2 - WhatsApp Cloud API
# -----------------------------------------------------------------------------
# developers.facebook.com > your app > WhatsApp > API Setup.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""      # any string you choose; Meta echoes it back
WHATSAPP_APP_SECRET=""        # verifies webhook signatures - never skip this


# -----------------------------------------------------------------------------
# P4 - M-Pesa (Daraja)
# -----------------------------------------------------------------------------
# developer.safaricom.co.ke > your app.
DARAJA_CONSUMER_KEY=""
DARAJA_CONSUMER_SECRET=""
DARAJA_SHORTCODE=""
DARAJA_PASSKEY=""


# =============================================================================
# NOT NEEDED - SokoLedger (Phase 2, parked)
# =============================================================================
# On-device M-Pesa SMS capture and the Kotlin agent are out of scope. The
# order-level payment rails in P4 are a different thing and use the keys above.
# =============================================================================
